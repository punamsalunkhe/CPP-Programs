//1).create a class student with the following attributes  name(string) ,roll number(intger),
//marks(interger array of size 5).2).implement the following member functions in the student class
// getdetails() ask the user to input the students details name , roll numbers,marks


#include <iostream>
#include <string>
using namespace std;

class Student {
    string name;
    int rollNumber;
    int marks[3]; // Example size 3 for marks

public:
    void getDetails() {
        cout << "Enter Student Name: ";
        getline(cin, name);

        cout << "Enter Roll Number: ";
        cin >> rollNumber;

        cout << "Enter Marks in 3 subjects:\n";
        for (int i = 0; i < 3; i++) {
            cout << "Subject " << (i + 1) << ": ";
            cin >> marks[i];
        }
        cin.ignore(); // Clear newline from buffer after marks input
    }

    void displayDetails() {
        cout << "\nStudent Name: " << name << endl;
        cout << "Roll Number: " << rollNumber << endl;
        cout << "Marks: ";
        for (int i = 0; i < 3; i++) {
            cout << marks[i] << " ";
        }
        cout << endl;
    }
};

int main() {
    int n;
    cout << "Enter number of students: ";
    cin >> n;
    cin.ignore(); // clear newline before getline for first student's name

    Student students[n]; // Array of student objects

    // Input details for each student
    for (int i = 0; i < n; i++) {
        cout << "\nEnter details for student " << (i + 1) << ":\n";
        students[i].getDetails();
    }

    // Display details for each student
    cout << "\nStudent details entered are:\n";
    for (int i = 0; i < n; i++) {
        students[i].displayDetails();
    }

    return 0;
}

